<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="person"
            type="com.example.m2tmdbluque.model.Person" />
        <variable
            name="scoreMax"
            type="float" />
        <variable
            name="scoreLabel"
            type="String" />
        <variable
            name="scoreColor"
            type="int" />
    </data>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.M2Tmdb.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/person_card_margin_horizontal"
        android:layout_marginVertical="@dimen/person_card_margin_vertical"
        android:clickable="true"
        android:focusable="true"
        app:cardElevation="0dp"
        app:rippleColor="?attr/colorPrimaryContainer"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/person_card_padding">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageProfile"
                android:layout_width="@dimen/person_poster_width"
                android:layout_height="@dimen/person_poster_height"
                android:background="@drawable/bg_placeholder_person"
                android:contentDescription="@string/person_photo"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.M2Tmdb.Poster"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                tools:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/person_content_margin_start"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@{person.name}"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Tom Holland" />

                    <ImageView
                        android:id="@+id/imageChevron"
                        android:layout_width="@dimen/person_chevron_size"
                        android:layout_height="@dimen/person_chevron_size"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOutline" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textDepartment"
                        style="@style/Widget.M2Tmdb.Chip.Department"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_soft"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/person_chip_padding_horizontal"
                        android:paddingVertical="@dimen/person_chip_padding_vertical"
                        android:text="@{person.knownForDepartment}"
                        tools:text="Acting" />

                    <TextView
                        android:id="@+id/textPopularity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@{@string/person_popularity(person.popularity)}"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorSecondary"
                        tools:text="★ 14.5" />
                </LinearLayout>

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/socialBarContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:minHeight="@dimen/social_bar_height"
                    android:saveEnabled="false"
                    tools:layout="@layout/fragment_social_bar" />

                <com.example.m2tmdbluque.ui.ScoreGaugeView
                    android:id="@+id/scoreGauge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:minHeight="@dimen/popularity_meter_height"
                    app:scoreColor="@{scoreColor}"
                    app:scoreLabel="@{scoreLabel}"
                    app:scoreMax="@{scoreMax}"
                    app:scoreValue="@{(float) person.popularity}" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
